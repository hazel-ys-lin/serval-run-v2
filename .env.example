# Mode: "full" (Postgres + MongoDB + Redis, default) or "lite"
# (SQLite + InMemoryQueue, no Mongo/Redis). Unknown values fall back to "full".
# SERVAL_MODE=full

# Database
# Full mode: postgres://user:pass@host:port/db
# Lite mode: sqlite:./path/to/file.db   (or sqlite::memory:)
DATABASE_URL=postgres://serval:changeme@localhost:5432/serval_run
# MONGODB_URL / REDIS_URL are not required (and not consumed) in lite mode.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=serval_run
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRATION_HOURS=24

# Server
HOST=0.0.0.0
PORT=3000

# Logging
RUST_LOG=serval_run=debug,sqlx=info